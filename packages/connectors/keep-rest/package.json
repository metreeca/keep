  "description": "REST/JSON proxy connector for @metreeca/keep.",
  "keywords": [
    "typescript",
    "json-ld",
    "model-driven",
    "rest"
  ],
  "homepage": "https://metreeca.github.io/keep/",
  "bugs": {
