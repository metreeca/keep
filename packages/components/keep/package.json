{
  "name": "@metreeca/keep",
  "version": "0.9.0",
  "description": "Core model-driven storage API for @metreeca/keep.",
  "keywords": [
    "typescript",
    "json-ld",
    "model-driven",
    "storage"
  ],
  "homepage": "https://metreeca.github.io/keep/",
  "bugs": {
    "url": "https://github.com/metreeca/keep/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/keep.git",
    "directory": "packages/components/keep"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@metreeca/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./validating": {
      "@metreeca/source": "./src/clients/validating.ts",
      "default": "./dist/clients/validating.js"
    },
    "./batching": {
      "@metreeca/source": "./src/clients/batching.ts",
      "default": "./dist/clients/batching.js"
    },
    "./caching": {
      "@metreeca/source": "./src/stores/caching.ts",
      "default": "./dist/stores/caching.js"
    },
    "./managing": {
      "@metreeca/source": "./src/stores/managing.ts",
      "default": "./dist/stores/managing.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist docs node_modules",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "npx vitest --typecheck run"
  },
  "dependencies": {
    "@metreeca/blue": "^0.9.1",
    "@metreeca/core": "^0.9.22",
    "@metreeca/http": "^0.1.1",
    "@metreeca/qest": "^0.9.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
